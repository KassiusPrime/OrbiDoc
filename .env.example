# Orbit / Nexus AI runtime -----------------------------------------------------
# SERVER-SIDE ONLY. Never expose these through VITE_* variables or commit real keys.
# Nexus AI uses OpenRouter as its only remote inference gateway and rejects paid
# model IDs at runtime. `openrouter/free` and explicit allowlisted `:free` IDs are
# the only permitted text routes.
OPENROUTER_API_KEY=
ORBIT_PUBLIC_URL=

# Zero-spend Web discovery for Nexus AI.
# Tavily is used only to retrieve search evidence; final reasoning remains on
# OpenRouter free models. When the free search quota is exhausted, Orbit fails
# closed instead of falling back to OpenRouter's paid Web Search tools.
TAVILY_API_KEY=

# Future free image route. Leave EMPTY while OpenRouter has no image model with
# a `:free` variant. Orbit rejects any value here that does not end in `:free`.
OPENROUTER_FREE_IMAGE_MODEL=

# Optional dedicated/self-hosted Real-ESRGAN service for faithful restoration.
# This is a deterministic media processor, not a second LLM provider.
REAL_ESRGAN_ENDPOINT=
REAL_ESRGAN_TOKEN=

# Stable public URLs used by the installation hub.
# Use the real production origin, including the trailing slash.
VITE_PUBLIC_APP_URL=https://orbidoc-cassianokaique9-3072s-projects.vercel.app/
VITE_ANDROID_APK_URL=
VITE_PLAY_STORE_URL=

# Orbit account authentication (Firebase Authentication / Spark plan).
# These values are public browser configuration, NOT service-account secrets.
# If left empty, Orbit falls back to firebase-applet-config.json.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Browser OAuth identifiers for optional external services.
# Google Drive is NOT required for Orbit account sign-in.
# In Google Cloud every deployed protocol+host+port must be registered under
# Authorized JavaScript origins or Google returns origin_mismatch.
VITE_GOOGLE_CLIENT_ID=

# Optional Microsoft 365 / Entra ID client identifier.
# Register /auth/microsoft as a SPA redirect URI; the client uses Authorization
# Code + PKCE.
VITE_MICROSOFT_CLIENT_ID=

# GitHub App integration for private projects.
# Browser values are public; the secret remains server-side only.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Native Android package metadata. The stable application ID remains unchanged
# during the OrbiDoc -> Orbit product-name migration so installed apps can update.
ANDROID_PACKAGE_NAME=app.orbidoc.workspace
ANDROID_TARGET_SDK=36

# Optional Android App Links.
ANDROID_APP_LINKS_ENABLED=false
ANDROID_SHA256_CERT_FINGERPRINT=
