# AI runtime (server-side only; NEVER expose these through VITE_* variables)
# On Vercel, OrbiDoc resolves the project OIDC token from the Function runtime
# with @vercel/oidc. AI_GATEWAY_API_KEY is only an explicit fallback for
# local/non-Vercel runtimes or deployments where OIDC is intentionally unavailable.
AI_GATEWAY_API_KEY=

# Optional direct provider credentials. When present, OrbiDoc can call the provider directly;
# when absent, the Vercel AI Gateway remains the resilient production route.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Optional dedicated Real-ESRGAN inference service for faithful 2x/4x restoration.
# If absent, OrbiDoc keeps the local HQ enhancer and can use the AI Gateway restoration fallback.
REAL_ESRGAN_ENDPOINT=
REAL_ESRGAN_TOKEN=

# Stable public URLs used by the in-app installation hub.
# Use the real production origin, including the trailing slash.
VITE_PUBLIC_APP_URL=https://orbidoc-cassianokaique9-3072s-projects.vercel.app/
# Fill only after the Android listing is actually published.
VITE_PLAY_STORE_URL=

# OrbiDoc account authentication (Firebase Authentication / Spark plan).
# These values are public browser configuration, NOT service-account secrets.
# If left empty, OrbiDoc falls back to firebase-applet-config.json.
# For a separate Firebase project, copy the Web App config from Firebase Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional named Firestore database. Leave empty to use the default database.
VITE_FIREBASE_DATABASE_ID=

# Browser OAuth identifiers for optional external services.
# Google Drive is NOT required for OrbiDoc account sign-in.
VITE_GOOGLE_CLIENT_ID=

# Optional Microsoft 365 / Entra ID client identifier.
# OneDrive is NOT required for OrbiDoc account sign-in.
VITE_MICROSOFT_CLIENT_ID=

# Android Trusted Web Activity (PWABuilder/Bubblewrap).
# Chrome's normal PWA/WebAPK installation does NOT require these values.
# For an APK/AAB TWA, set both after the Android signing certificate exists.
# Recommended stable package name: app.orbidoc.workspace
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINT=
# Google Play requirement for new apps/updates from 2026-08-31.
# The generated Android/TWA project must use this targetSdk or newer.
ANDROID_TARGET_SDK=36
