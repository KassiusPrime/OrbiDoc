# AI runtime (server-side only; NEVER expose these through VITE_* variables)
# On Vercel, OrbiDoc resolves the project OIDC token from the Function runtime
# with @vercel/oidc. AI_GATEWAY_API_KEY is only an explicit fallback for
# local/non-Vercel runtimes or deployments where OIDC is intentionally unavailable.
AI_GATEWAY_API_KEY=

# Optional direct provider credentials. When present, OrbiDoc can call the provider directly;
# when absent, the Vercel AI Gateway remains the resilient production route.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Browser OAuth identifiers. These are public client identifiers, not API secrets.
VITE_GOOGLE_CLIENT_ID=

# Optional Microsoft 365 / Entra ID client identifier.
# The app must not fabricate a Microsoft session when this is empty.
VITE_MICROSOFT_CLIENT_ID=

# Android Trusted Web Activity (PWABuilder/Bubblewrap).
# Chrome's normal PWA/WebAPK installation does NOT require these values.
# For an APK/AAB TWA, set both after the Android signing certificate exists.
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINT=
