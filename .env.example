GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Browser OAuth identifiers. These are public client identifiers, not API secrets.
VITE_GOOGLE_CLIENT_ID=

# Microsoft 365 is intentionally disabled until official Entra ID / Microsoft Graph OAuth is configured.
