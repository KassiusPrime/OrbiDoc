{
  "name": "orbidoc-workspace",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/generate-assetlinks.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "lint": "node scripts/lint-source.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun run verify:pwa",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@tabler/icons-react": "^3.46.0",
    "@types/file-saver": "^2.0.7",
    "@vercel/oidc": "3.8.4",
    "clsx": "2.1.1",
    "docx": "^9.7.1",
    "express": "^5.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.16.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.26.0",
    "mammoth": "^1.8.0",
    "motion": "^12.42.2",
    "pdfjs-dist": "^4.4.168",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "3.4.0",
    "tesseract.js": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "^5.0.6",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.1",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
